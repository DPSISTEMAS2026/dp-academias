# Copia este archivo a .env en la raíz del repo. No lo commitees.

# --- Supabase del producto (ydbefwfqkimznydpybss). ---
SUPABASE_URL=https://ydbefwfqkimznydpybss.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Si se endurece RLS (deny-anon), el API debe usar esta clave. Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Solo para scripts de migración local (opcional)
SUPABASE_DB_PASSWORD=

# --- App ---
PORT=3002
FRONTEND_URL=http://localhost:5173
ACADEMY_NAME=Academia Demo
CONTACT_EMAIL=contacto@dpsistemas.cl

# --- Cliente Vite ---
VITE_API_URL=http://localhost:3002
# En Netlify del subdominio academias.dpsistemas.cl deja: /
VITE_BASE=/

# --- Pagos (Mercado Pago de esta plataforma, no el de otra academia) ---
VITE_MP_ACCESS_TOKEN=
VITE_MP_PUBLIC_KEY=

JWT_SECRET=
INTERNAL_KEY=
DEMO_LOCK=false
DP_STAFF_EMAIL=
DP_STAFF_PASSWORD=
# Academia que usa el login de academias.dpsistemas.cl/acceso (la demo).
DEMO_ACADEMY_SLUG=dpdemo
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contacto@dpsistemas.cl

# Cloudflare R2 (no Images, no Data Catalog). Tope duro 8 GB de 10 GB gratis.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dp-academias-fotos
R2_PUBLIC_BASE=
R2_MAX_BYTES=8000000000
R2_MAX_FILE_BYTES=409600
